{
  "folders": [
    {
      "name": "scripts",
      "path": "../../scripts/Promotion"
    },
    {
      "name": "docs",
      "path": "../../docs"
    },
    {
      "name": "shared",
      "path": "../../src/BuildingBlocks"
    },
    {
      "name": "service",
      "path": "../../src/Services/Promotion"
    }
  ],
  "settings": {
    "dotnet.projects.loadProjectsOnDemand": true,
    "files.exclude": {
      "**/bin": true,
      "**/obj": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/.next": true,
      "**/coverage": true
    },
    "search.exclude": {
      "**/bin": true,
      "**/obj": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/.next": true,
      "**/coverage": true
    },
    "files.watcherExclude": {
      "**/bin": true,
      "**/obj": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/.next": true,
      "**/coverage": true
    }
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Docker: Promotion API",
        "type": "coreclr",
        "request": "attach",
        "processName": "dotnet",
        "justMyCode": false,
        "pipeTransport": {
          "pipeCwd": "${workspaceFolder:scripts}/../..",
          "pipeProgram": "docker",
          "pipeArgs": [
            "compose",
            "-f",
            "docker-compose.development.yml",
            "exec",
            "-i",
            "promotion-api"
          ],
          "debuggerPath": "/vsdbg/vsdbg",
          "quoteArgs": false
        },
        "sourceFileMap": {
          "/app/src/Services/Promotion": "${workspaceFolder:service}",
          "/app/src/BuildingBlocks": "${workspaceFolder:shared}"
        },
        "preLaunchTask": "compose-up: promotion-api (wait)"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "compose-up: promotion-api (wait)",
        "type": "shell",
        "command": "docker",
        "args": [
          "compose",
          "-f",
          "docker-compose.development.yml",
          "up",
          "-d",
          "--wait",
          "promotion-api"
        ],
        "options": {
          "cwd": "${workspaceFolder:scripts}/../.."
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "silent",
          "panel": "shared"
        }
      }
    ]
  }
}

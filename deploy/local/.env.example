# ============================================================================
# NovaCore LOCAL Development Environment
# Minimal stack for nova-console frontend development: Gateway + Auth + User +
# Audit + Notification only. Copy to .env (same directory) and fill in values.
# See deploy/local/README.md for the full setup workflow.
#
# Every key below has a sensible built-in default in application code EXCEPT
# the ones in this file - that's why the list is short compared to the root
# .env.template. See README.md "Configuration" section for what's fixed vs
# tunable.
# ============================================================================

# ============================================================================
# DOCKER COMPOSE
# ============================================================================
COMPOSE_PROJECT_NAME=

# ============================================================================
# GLOBAL POSTGRESQL
# Already running on this machine - this compose does NOT start a Postgres
# container. auth_db/user_db (+ one *_hangfire_db per service) are created
# inside this instance by the db-init job on first `docker compose up`.
# ============================================================================
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ============================================================================
# GLOBAL REDIS
# Already running on this machine - this compose does NOT start a Redis
# container. Required by the Gateway (refresh-token check) and by Auth/User
# (Cache). NOT used by Audit or Notification - see README.md.
# ============================================================================
REDIS_HOST=
REDIS_PORT=

# ============================================================================
# LOCAL MONGODB
# The one piece of infrastructure THIS compose does start - Audit and
# Notification store domain data in Mongo and there is no global instance
# assumption for it (unlike Postgres/Redis). Single lightweight container,
# bootstrapped by the existing scripts/mongodb/init-mongo.js.
# ============================================================================
MONGO_IMAGE=
MONGO_PORT=
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# ============================================================================
# SHARED JWT
# Auth issues tokens; Gateway/User/Audit/Notification only validate them, so
# all five MUST use the same SecretKey/Issuer/Audience.
# ============================================================================
JWT_SECRET_KEY=
JWT_ISSUER=
JWT_AUDIENCE=

# ============================================================================
# API GATEWAY
# The only host-published HTTP entrypoint - matches nova-console's default
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api. Every other service is
# reachable only via the Gateway or `docker compose exec`/container name,
# except for the direct debug ports below (Swagger/VS Code attach).
# ============================================================================
GATEWAY_PUBLIC_PORT=

# ============================================================================
# AUTH SERVICE
# ============================================================================
# Direct debug port (bypasses the Gateway; bound to 127.0.0.1 only - for
# local Swagger/VS Code attach, never for nova-console traffic)
AUTH_PUBLIC_HTTP_PORT=

# ============================================================================
# USER SERVICE
# ============================================================================
USER_PUBLIC_HTTP_PORT=

# ============================================================================
# AUDIT SERVICE
# ============================================================================
AUDIT_PUBLIC_HTTP_PORT=
AUDIT_MONGO_DATABASE=

# ============================================================================
# NOTIFICATION SERVICE
# ============================================================================
NOTIFICATION_PUBLIC_HTTP_PORT=
NOTIFICATION_MONGO_DATABASE=

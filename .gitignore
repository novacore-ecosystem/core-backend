# Environment Variables
.env
.env.local
.env.*.local
.env.prod

# IDE
# .vscode is developer-local by default. Only .vscode/workspaces/*.code-workspace
# is a tracked project artifact - to track another .vscode path, add an explicit
# negation for it the same way, rather than un-ignoring .vscode/ wholesale.
.vscode/*
!.vscode/workspaces/
.vscode/workspaces/*
!.vscode/workspaces/*.code-workspace
.idea/
*.swp
*.swo
*~
.DS_Store

# Build & Dependencies
bin/
obj/
*.csproj.user
packages/
node_modules/
dist/

# Database
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# Docker
docker-compose.override.local.yml

# Temporary
tmp/
temp/
*.tmp
development.code-workspace

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=pg;Port=5432;Database=product_db;User Id=postgres;Password=NovaCore@Postgres2026;",
    "Hangfire": "Server=pg;Port=5432;Database=product_hangfire_db;User Id=postgres;Password=NovaCore@Postgres2026;"
  },
  "Jwt": {
    "SecretKey": "NovaCore-Development-Secret-Key-Replace-Me",
    "Issuer": "NovaCore.Auth",
    "Audience": "NovaCore.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "Jobs": {
    "OutboxCleanup": {
      "JobId": "product-outbox-cleanup",
      "CronExpression": "0 */5 * * * *",
      "Queue": "default",
      "Enabled": true,
      "RetentionPeriod": "30.00:00:00",
      "BatchSize": 100,
      "MaxBatchesPerRun": 10
    },
    "InboxCleanup": {
      "JobId": "product-inbox-cleanup",
      "CronExpression": "0 */5 * * * *",
      "Queue": "default",
      "Enabled": true,
      "RetentionPeriod": "30.00:00:00",
      "BatchSize": 100,
      "MaxBatchesPerRun": 10
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200"
  }
}

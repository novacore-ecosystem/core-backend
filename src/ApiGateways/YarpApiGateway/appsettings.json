      },
      "Content": {
        "Url": "http://content-api:8080",
        "Name": "Content",
        "Path": "/api/content/",
        "SwaggerUrl": "swagger/v1/swagger.json",
        "RequireAuth": true
      },
      "Inventory": {
        "Url": "http://inventory-api:8080",
        "Name": "Inventory",
        "Path": "/api/inventory/",
        "SwaggerUrl": "swagger/v1/swagger.json",
        "RequireAuth": true
      },
      "Notification": {
        "Url": "http://notification-api:8080",
        "Name": "Notification",
        "Path": "/api/notification/",
        "SwaggerUrl": "swagger/v1/swagger.json",

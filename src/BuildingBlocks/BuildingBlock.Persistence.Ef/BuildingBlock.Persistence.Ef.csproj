<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BuildingBlock.Persistence\BuildingBlock.Persistence.csproj" />
    <ProjectReference Include="..\BuildingBlock.Criteria\BuildingBlock.Criteria.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <RootNamespace>NovaCore.BuildingBlock.Persistence.Ef</RootNamespace>
    <AssemblyName>NovaCore.BuildingBlock.Persistence.Ef</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Overridden above the 10.0.0 central pin: EntityFrameworkCore 10.0.1 (already used here)
         floors Microsoft.Extensions.Caching.Memory at 10.0.1, which floors this at 10.0.1 too. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.1" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

</Project>

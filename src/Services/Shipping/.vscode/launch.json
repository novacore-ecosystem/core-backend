{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Docker: Shipping API",
      "type": "coreclr",
      "request": "attach",
      "processName": "dotnet",
      "justMyCode": false,
      "pipeTransport": {
        "pipeCwd": "${workspaceFolder}/../../..",
        "pipeProgram": "docker",
        "pipeArgs": [
          "compose",
          "-f",
          "docker-compose.development.yml",
          "exec",
          "-i",
          "shipping-api"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": false
      },
      "sourceFileMap": {
        "/app/src/Services/Shipping": "${workspaceFolder}",
        "/app/src/BuildingBlocks": "${workspaceFolder}/../../BuildingBlocks"
      },
      "preLaunchTask": "compose-up: shipping-api (wait)"
    }
  ]
}

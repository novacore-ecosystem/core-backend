{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compose-up: payment-api (wait)",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "docker-compose.development.yml",
        "up",
        "-d",
        "--wait",
        "payment-api"
      ],
      "options": {
        "cwd": "${workspaceFolder}/../../.."
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ]
}

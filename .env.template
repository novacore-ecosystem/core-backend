# ============================================================================
# POSTGRESQL - SHARED CONFIGURATION
# Dev: single pg-global instance, one logical database per service (see each service's
# Vault blueprint for ConnectionStrings__DefaultConnection). Root credentials below are
# also embedded in those Vault connection strings by necessity - the same password
# provisions the container AND lets services connect into it. In staging/prod this
# shifts to Vault's database secrets engine issuing short-lived per-service credentials
# instead of one shared static password.
# ============================================================================
PG_CONTAINER_NAME=
PG_DATABASE=
POSTGRES_PORT=
POSTGRES_IMAGE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_INITDB_ARGS=

# ============================================================================
# MONGODB - SHARED INFRASTRUCTURE (dev: single mongo-global instance)
# ============================================================================
MONGO_IMAGE=
MONGO_CONTAINER_NAME=
MONGO_PORT=
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# ============================================================================
# REDIS - SHARED INFRASTRUCTURE
# ============================================================================
REDIS_IMAGE=
REDIS_CONTAINER_NAME=
REDIS_PORT=

# ============================================================================
# KAFKA - SHARED INFRASTRUCTURE (KRaft mode, no Zookeeper)
# Note: docker-compose.development.yml hardcodes its own lightweight dev tuning
# (replication factor 1, 24h retention) directly rather than reading it from here -
# these vars back the docker-compose.yml/override.yml canonical pair only.
# ============================================================================
KAFKA_IMAGE=
KAFKA_CONTAINER_NAME=
KAFKA_PORT=
KAFKA_NODE_ID=
KAFKA_CONTROLLER_PORT=
KAFKA_CLUSTER_ID=
KAFKA_AUTO_CREATE_TOPICS=
KAFKA_LOG_RETENTION_HOURS=
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=

# ============================================================================

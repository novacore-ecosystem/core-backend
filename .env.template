# ============================================================================
# NovaCore Docker Configuration Template
# Copy this file to .env and fill in the values
# .env is ignored in git - use this template to track required variables
# ============================================================================

# ============================================================================
# DOCKER COMPOSE - INFRASTRUCTURE
# ============================================================================
COMPOSE_PROJECT_NAME=
COMPOSE_NETWORK=

# ============================================================================
# HASHICORP VAULT
# Every app service fetches its own config from these paths at startup (via
# scripts/vault/fetch-and-run.sh in the shell entrypoint, and via the .NET
# VaultConfigurationExtensions.AddVaultSecretsAsync() in Program.cs). VAULT_PATHS itself
# is set per-service in the compose files, not here - each entry is self-contained as
# "<mount>/<secret-path>" (e.g. "kv/nova-core/dev/security"), so no separate mount
# variable is needed - this block only supplies how to REACH Vault.
# ============================================================================
VAULT_ADDR=
VAULT_TOKEN=

# ============================================================================
# ASP.NET CORE - GLOBAL SETTINGS
# ============================================================================
ASPNETCORE_ENVIRONMENT=
ASPNETCORE_URLS=
ASPNETCORE_HTTP_PORT=
ENVIRONMENT=
LOG_LEVEL=
DEBUG=

# ============================================================================
# API GATEWAY (YARP)
# ============================================================================
GATEWAY_CONTAINER_NAME=
GATEWAY_PUBLIC_PORT=
GATEWAY_HTTP_PORT=


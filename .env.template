# Gateway Redis Configuration (refresh token existence check only; shared Redis instance)
GATEWAY_REDIS_CONNECTION_STRING=

# ============================================================================
# AUDIT SERVICE
# ============================================================================
AUDIT_CONTAINER_NAME=
AUDIT_SERVICE_URL=
AUDIT_URLS=
AUDIT_HTTP_PORT=

# Public debug port (host -> container, bound to 127.0.0.1 only; bypasses the Gateway,
# for local VS Code attach / direct Swagger access only - never expose beyond localhost)
AUDIT_PUBLIC_HTTP_PORT=

# Audit domain data is 100% MongoDB (BuildingBlock.Persistence.Mongo) - no Postgres connection
# string here. Mongo connection strings don't embed a working database the way this codebase's
# Postgres ones do, so the database name is supplied separately.
AUDIT_MONGODB_URL=
AUDIT_MONGO_DATABASE=

# Audit Hangfire Database (PostgreSQL - Hangfire storage is Postgres-only in this codebase
# regardless of a service's primary datastore; Audit's own domain data stays 100% Mongo)
AUDIT_HANGFIRE_DB_CONNECTION=

# Audit Dependencies
AUDIT_KAFKA_BROKERS=
AUDIT_SEQ_URL=

# Audit Inbox/Outbox Cleanup Jobs (retention in TimeSpan format d.hh:mm:ss). Audit both
# consumes (from every other service) and publishes (wired but currently unused - proves
# BuildingBlock.Persistence.Mongo's Outbox store end-to-end), so it needs both cleanup jobs.
AUDIT_OUTBOX_CLEANUP_JOB_ID=
AUDIT_OUTBOX_CLEANUP_CRON=
AUDIT_OUTBOX_CLEANUP_QUEUE=
AUDIT_OUTBOX_CLEANUP_ENABLED=
AUDIT_OUTBOX_CLEANUP_RETENTION=
AUDIT_OUTBOX_CLEANUP_BATCH_SIZE=
AUDIT_OUTBOX_CLEANUP_MAX_BATCHES=
AUDIT_INBOX_CLEANUP_JOB_ID=
AUDIT_INBOX_CLEANUP_CRON=

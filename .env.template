# ============================================================================
SEQ_IMAGE=
SEQ_CONTAINER_NAME=
SEQ_PORT=
SEQ_ACCEPT_EULA=
SEQ_FIRSTRUN_ADMINPASSWORD=

# ============================================================================
# ELASTICSEARCH - SHARED SEARCH INFRASTRUCTURE
# Backs docker-compose.yml/override.yml (canonical pair). docker-compose.development.yml
# runs its own minimal single-node/no-auth Elasticsearch and does not read these vars.
# ============================================================================
ELASTICSEARCH_IMAGE=
ELASTICSEARCH_CONTAINER_NAME=
ELASTICSEARCH_PORT=
ELASTICSEARCH_URL=
ELASTICSEARCH_DISCOVERY_TYPE=
ELASTICSEARCH_XPACK_SECURITY_ENABLED=
ELASTICSEARCH_HTTP_SSL_ENABLED=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_APP_USERNAME=
ELASTICSEARCH_JAVA_OPTS=

# ============================================================================
# KIBANA - SHARED VISUALIZATION INFRASTRUCTURE
# Canonical pair only - intentionally excluded from docker-compose.development.yml
# to save local machine resources.
# ============================================================================
KIBANA_IMAGE=
KIBANA_CONTAINER_NAME=
KIBANA_PORT=
KIBANA_ELASTICSEARCH_HOSTS=

# ============================================================================
